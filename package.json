{
  "name": "ai-suite",
  "version": "1.0.0",
  "description": "Full-featured AI Suite with Chatbot, Image Generator, Data Analysis, and Code Assistant",
  "main": "server/index.js",
  "scripts": {
    "install-all": "npm install && cd client && npm install",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js"
  },
  "keywords": ["AI", "chatbot", "image-generation", "data-analysis"],
  "author": "seifprogramer",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "@supabase/supabase-js": "^2.26.0",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.3.0",
    "socket.io": "^4.5.4"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "concurrently": "^7.6.0"
  }
}
